# Copie este arquivo para ".env" e preencha com seus próprios valores
# para rodar o projeto localmente. Em produção (App Platform), essas
# mesmas variáveis são configuradas direto no painel — não existe .env lá.
#
# NUNCA COMMITE O ARQUIVO ".env" (ele já está no .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Banco de dados ---
# Deixe em branco para usar SQLite localmente. Em produção, o App
# Platform preenche isso sozinho quando você vincula o banco ao app.
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco?sslmode=require
DATABASE_URL=

# --- DigitalOcean Spaces (upload de imagens das questões) ---
# Deixe tudo em branco para usar a pasta media/ local em vez do Spaces.
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_BUCKET_NAME=
SPACES_REGION=nyc3
SPACES_CDN_DOMAIN=
SPACES_URL_EXPIRE_SECONDS=3600
